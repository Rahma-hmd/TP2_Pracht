---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import penguins from "../../data/penguins.json";

const penguinsChinstrap = penguins.filter(
    ({ species }) => species === "Chinstrap",
);
---

<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <title>Penguins Chinstrap</title>
    </head>

    <body>
        <nav>
            <a href="/species/Adelie/">Adelie</a>
            <a href="/species/Gentoo/">Gentoo</a>
            <a href="/species/Chinstrap/">Chinstrap</a>
        </nav>

        <h1>Penguins Chinstrap</h1>

        <PlotFigure
            options={{
                marks: [
                    Plot.dot(penguinsChinstrap, {
                        x: "culmen_length_mm",
                        y: "culmen_depth_mm",
                    }),
                ],
            }}
        />
    </body>
</html>
