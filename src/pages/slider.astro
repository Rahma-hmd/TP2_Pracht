---
import "../styles/global.css";
import GraphicSpecies from "../components/GraphicSpecies.astro";
---

<html lang="fr" data-theme="caramellatte">
    <head>
        <meta charset="UTF-8" />
        <title>Penguins Slider</title>
    </head>

    <body class="penguin-page">
        <h1>Penguins</h1>

        <nav>
            <a class="menu-item" href="#adelie">Adelie</a>
            <a class="menu-item" href="#gentoo">Gentoo</a>
            <a class="menu-item" href="#chinstrap">Chinstrap</a>
        </nav>

        <div class="slider">
            <section class="item" id="adelie">
                <GraphicSpecies species="Adelie" />
            </section>

            <section class="item" id="gentoo">
                <GraphicSpecies species="Gentoo" />
            </section>

            <section class="item" id="chinstrap">
                <GraphicSpecies species="Chinstrap" />
            </section>

            <script>
                const menuItems = document.querySelectorAll(".menu-item");
                const items = document.querySelectorAll(".item");

                console.log("menuItems", menuItems);
                console.log("items", items);

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            const id = entry.target.getAttribute("id");

                            const menuItem = document.querySelector(
                                `.menu-item[href="#${id}"]`,
                            );

                            if (entry.isIntersecting) {
                                menuItem?.classList.add("active");
                            } else {
                                menuItem?.classList.remove("active");
                            }
                        });
                    },
                    {
                        threshold: 0.5,
                    },
                );

                items.forEach((item) => {
                    observer.observe(item);
                });
            </script>
        </div>
    </body>

    <style>
        html {
            scroll-behavior: smooth;
        }

        nav {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
        }

        .menu-item {
            padding: 10px 20px;
            text-decoration: none;
            color: black;
        }

        .menu-item.active {
            background-color: #fecaca;
        }

        .slider {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
        }

        .item {
            min-width: 100%;
            scroll-snap-align: start;
        }
    </style>
</html>
